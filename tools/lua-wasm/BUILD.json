  "patches": [
    {
      "file": "luaconf.h",
      "why": "Wow.exe converts numbers with MSVC's \"%.14g\": 1e+015, 1.#INF, -1.#IND (wow_lua.c)"
    },
    {
      "file": "luaconf.h",
      "why": "Wow.exe's lua_number2int is fld/fistp: round to nearest even, 0x80000000 out of range (no wasm trap)"
    },
    {
      "file": "loslib.c",
      "why": "declarations of the host-time-zone helpers"
    },
    {
      "file": "loslib.c",
      "why": "os.execute/remove/rename/tmpname/getenv are not built (tmpnam does not exist on WASI)"
    },
    {
      "file": "loslib.c",
      "why": "end of the block above"
    },
    {
      "file": "loslib.c",
      "why": "wasi-libc has no time zones: local time = UTC + the host's offset (JS Date), as fengari's os.date"
    },
    {
      "file": "loslib.c",
      "why": "same for os.time{...}"
    },
    {
      "file": "loslib.c",
      "why": "the glue preamble keeps only os.date/time/clock; dropping the rest keeps path_open & co. out of the imports"
    },
    {
      "file": "loslib.c",
      "why": "same"
    }
  ],
