{
  "name": "tswow-web-client",
  "version": "0.0.1",
  "description": "Educational browser client and interoperability research project for TSWoW/TrinityCore WoW 3.3.5a.",
  "license": "SEE LICENSE IN NOTICE.md",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "keywords": [
    "tswow",
    "trinitycore",
    "wow-3.3.5a",
    "educational",
    "interoperability",
    "threejs",
    "webgl",
    "typescript"
  ],
  "scripts": {
    "protocol:generate": "node tools/generate-protocol.mjs",
    "protocol:check": "node tools/generate-protocol.mjs --check",
    "dbc:generate": "node tools/generate-dbc-layouts.mjs",
    "dbc:check": "node tools/generate-dbc-layouts.mjs --check",
    "animations:generate": "node tools/generate-animations.mjs",
    "animations:check": "node tools/generate-animations.mjs --check",
    "deadopcodes:generate": "node tools/generate-dead-opcodes.mjs",
    "deadopcodes:check": "node tools/generate-dead-opcodes.mjs --check",
    "strings:generate": "node tools/generate-global-strings.mjs",
    "strings:check": "node tools/generate-global-strings.mjs --check",
    "classicons:generate": "node tools/generate-class-icons.mjs",
    "classicons:check": "node tools/generate-class-icons.mjs --check",
    "client-data:prepare": "node tools/prepare-client-data.mjs",
    "client-data:generate": "npm run protocol:generate && npm run deadopcodes:generate && npm run animations:generate && npm run strings:generate && npm run classicons:generate",
    "client-data:check": "npm run animations:check && npm run strings:check && npm run classicons:check",
    "source-data:prepare": "npm run protocol:generate && npm run deadopcodes:generate && npm run client-data:prepare",
    "modules:check": "node tools/check-modules.mjs",
    "dbd:fetch": "node tools/fetch-dbd.mjs",
    "assets:icons": "node tools/generate-spell-icons.mjs --all",
    "assets:restamp": "node tools/restamp.mjs",
    "assets:creatures": "node tools/generate-creature-metadata.mjs",
    "assets:items": "node tools/generate-item-metadata.mjs",
    "assets:item-icons": "node tools/generate-item-icon.mjs --all",
    "assets:terrain": "node tools/generate-terrain-tile.mjs",
    "assets:minimap": "node tools/generate-minimap-index.mjs --all",
    "assets:minimap-tiles": "node tools/generate-minimap-tiles.mjs",
    "check:generated": "npm run protocol:check && npm run dbc:check && npm run animations:check && npm run deadopcodes:check && npm run strings:check && npm run classicons:check",
    "check:workspace": "npm run check:generated && npm run modules:check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretypecheck": "npm run source-data:prepare",
    "build": "tsc -p tsconfig.json && vite build",
    "prebuild": "npm run source-data:prepare",
    "build:full": "npm run check:workspace && npm run build",
    "prebuild:full": "npm run source-data:prepare",
    "doctor": "node tools/check-config.mjs",
    "dev": "vite",
    "predev": "npm run source-data:prepare",
    "gateway": "node --enable-source-maps tools/start-gateway.mjs",
    "pregateway": "npm run build",
    "gateway:dev": "npm run gateway",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "dependencies": {
    "@wowserhq/stormjs": "^0.4.1",
    "pngjs": "^7.0.0",
    "three": "^0.185.1",
    "ws": "8.21.0"
  }
}
