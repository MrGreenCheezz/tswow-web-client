# Copy this file to .env and replace the paths with your own locations.
# Use forward slashes on Windows to keep the file easy to read.

# A legally obtained World of Warcraft 3.3.5a client (build 12340), containing Data/.
CLIENT_DIR=C:/Games/WoW-3.3.5a

# Optional exact AddOns.txt inside CLIENT_DIR/WTF. Without it, only byte-identical local profiles
# are used; divergent or missing profiles leave installed add-on defaults unchanged.
# CLIENT_ADDONS_FILE=C:/Games/WoW-3.3.5a/WTF/Account/MyAccount/MyRealm/MyCharacter/AddOns.txt
# `npm run client-addons:check` skips add-ons that profile disables; 1 checks them too, reported
# separately as "disabled" (offline check only; the gateway and the page are unaffected).
# CLIENT_ADDONS_INCLUDE_DISABLED=0

# Optional GM console catalog (quests, teleports, game objects) written by tools/generate-gm-catalog.mjs.
# Default: data/gm-catalog.json under the working directory.
# GM_CATALOG_FILE=data/gm-catalog.json

# Optional autonomous snapshot created by `npm run client-pack:build`. When set, every gateway and
# asset generator reads this pack instead of CLIENT_DIR. The source client can then be disconnected
# or moved; run `npm run client-pack:verify` after copying the pack to another disk.
# CLIENT_PACK_DIR=C:/tswow-web-client/dist/client-pack

# Optional explicit visual DBC overlay. Its DBC files are trusted as-is; keep it in sync with
# CLIENT_DIR yourself and copy the generated .src sidecars too when using patch-W/X/Y/Z-specific
# geoset policy. Without the override, data/visual-dbc is used only when every .src stamp matches
# the current client archive chain (`npm run assets:visual-dbc`).
# VISUAL_DBC_DIR=C:/Games/WoW-3.3.5a-visual-dbc

# Either point at a complete TSWoW installation...
TSWOW_INSTALL=C:/tswow/tswow-install
# ...or point directly at its built dataset. TSWOW_DATASET wins when both are set.
# TSWOW_DATASET=C:/tswow/tswow-install/modules/default/datasets/dataset

# Required before build/test for ignored local protocol tables, by `npm run client-data:generate`
# for matching client/core joins, and by full generated-source checks (`npm run build:full`).
TRINITYCORE_DIR=C:/tswow/tswow/cores/TrinityCore

# Must match the locale used by the client archives and realm data.
CLIENT_LOCALE=ruRU
VITE_CLIENT_LOCALE=ruRU

# After configuring these paths, generate the ignored local protocol/client tables for gameplay:
# npm run client-data:generate
# The generated files remain on this machine and must never be committed or redistributed.

# Safe single-machine defaults. For LAN use, change both hosts and restrict ALLOWED_ORIGINS.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8090
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_HOST=127.0.0.1
AUTH_PORT=3724
WORLD_HOST=127.0.0.1
WORLD_PORT=8085
WEB_HOST=127.0.0.1
WEB_PORT=5173
# Comma-separated DNS hostnames Vite may answer when WEB_HOST is exposed to a LAN.
# WEB_ALLOWED_HOSTS=wow.lan

# Optional public origin of the gateway or reverse proxy, without /auth or /world.
# When blank, the browser derives the gateway host from the current page and uses port 8090.
# Set this (including the port) whenever GATEWAY_PORT is not 8090.
# VITE_GATEWAY_ORIGIN=https://wow.example.com
# A ?gateway=<address> link is honoured only for the page's own host, loopback-to-loopback, the
# gateway above, or an origin listed here (comma separated, full origins with scheme and port).
# Everything else is refused and the page stays on its default gateway. Empty by default.
# VITE_GATEWAY_ALLOWED_ORIGINS=https://gw2.example.com

# Optional overrides for a dataset with a custom layout.
# DBC_DIR=C:/tswow/dataset/dbc
# MAPS_DIR=C:/tswow/dataset/maps
# VMAPS_DIR=C:/tswow/dataset/vmaps
# MODULE_DIRS=C:/my-module-drafts;C:/tswow/tswow-install/modules>content
# WORLDSERVER_CONF=C:/tswow/realm/worldserver.conf
# MYSQL_BIN=C:/tswow/tswow-install/bin/mysql/mysql.exe

# Disabled by default. Allows the window builder to write module UI files. Only for a loopback-only
# gateway: with GATEWAY_HOST not loopback, or ALLOWED_ORIGINS containing * or another host, the gateway
# refuses to start (npm run doctor reports it). Each write must also come from a loopback page, with
# no proxy headers.
MODULE_UI_WRITE=0

# A TSWoW `build addon` / `build data` rewrites the client patches; the running gateway then answers
# 409 client_patch_chain_changed (the page shows a banner) until it is restarted. Set this to 1 and
# `npm run gateway` stays as a small supervisor that restarts the already-built gateway by itself
# once the build has settled (no patch change for 5 s and TSWoW's last-client-build.json is newer,
# or 2 minutes without a marker) AND nobody is connected to /auth or /world. It never rebuilds and
# never starts the auth/world servers. `npm run patches:status` shows what the gateway serves.
# GATEWAY_RESTART_ON_PATCH=0
# The same supervisor also starts a crashed gateway again (after 1, 2, 5, 15, 60 s; a sixth crash
# within 10 minutes stops it for good). GATEWAY_SUPERVISE=1 gives only that crash restart, without
# the restart after a build.
# GATEWAY_RESTART_DEADLINE_MIN: connected players hold the restart after a settled build back for this
# many whole minutes at most (unset = 5; 0 = wait for them for ever; up to 1440). Meanwhile their page
# counts it down («Сервер перезапустится через M:SS»); then the gateway closes their connections
# with code 4001 («Сервер перезапускается после обновления») and restarts. With nobody connected
# the restart is immediate, as before.
# GATEWAY_SUPERVISE=0
# GATEWAY_RESTART_DEADLINE_MIN=5

# Serving the game to other players from this machine (bat/32, serving players) and the app to send
# them (bat/30, the player kit: the app, a start guide with this address, the playtest guide). PUBLIC_HOST is the address players reach this machine by; TCP
# PUBLIC_WEB_PORT (the page) and GATEWAY_PORT (8090, the gateway) must be forwarded to it. The
# server listens on PUBLIC_BIND (default 0.0.0.0, every interface) and never writes module UI.
# PUBLIC_HOST=203.0.113.10
# PUBLIC_WEB_PORT=8091
# PUBLIC_BIND=0.0.0.0
# Players reaching the page by another name (a DNS name, www.) need that origin in ALLOWED_ORIGINS:
# the server keeps .env's list and adds http://PUBLIC_HOST:PUBLIC_WEB_PORT and its loopback twins.
# It serves index.html and its assets only (glue.html, framexml.html, character-lab.html stay local).
# The players' site at / (download the app, register, play in the browser; the game itself at /play/)
# lets anyone create an account in the auth database of WORLDSERVER_CONF; PUBLIC_REGISTRATION=0 closes it.
# PUBLIC_REGISTRATION=1
# GATEWAY_LOG_BACKPRESSURE=1 prints one line per closed /auth or /world bridge: the largest queue
# towards the player and towards the server, and how often and how long the gateway paused reading
# the faster side for a slow line (numbers only). Off by default.
# GATEWAY_LOG_BACKPRESSURE=0
# Failed logins per player address. The auth and world servers see every player as the gateway
# itself, so their own limits cannot tell players apart: a WrongPass IP ban would ban everybody, and
# with WrongPass.MaxCount = 0 password guessing is unlimited. The gateway reads the authserver's answer
# on each /auth connection: a wrong account name or password is a failure, a successful login clears
# that address's count. After GATEWAY_LOGIN_MAX_FAILURES failures within GATEWAY_LOGIN_WINDOW_MIN
# minutes the address's /auth connections are closed at once (code 4290, the page says "too many
# attempts") for GATEWAY_LOGIN_LOCKOUT_MIN minutes, and the gateway logs one line with the address
# (never the account name). Logins still waiting for their answer count against the same budget.
# The address is the TCP peer's, never X-Forwarded-For, so behind a reverse proxy all players share
# the proxy's count. Loopback (this machine) is limited too; a gateway restart forgets every count.
# GATEWAY_LOGIN_MAX_FAILURES=0 switches the limit off.
# GATEWAY_LOGIN_MAX_FAILURES=5
# GATEWAY_LOGIN_WINDOW_MIN=15
# GATEWAY_LOGIN_LOCKOUT_MIN=15

# Generated-cache locations may also be overridden when storage belongs elsewhere:
# CREATURE_METADATA_FILE, ITEM_METADATA_FILE, ITEM_ICON_DIR, SPELL_ICON_DIR,
# CREATURE_ICON_DIR, BUILDINGS_DIR, TERRAIN_TEXTURE_DIR, TERRAIN_LAYER_DIR,
# VISUAL_TILE_DIR, VISUAL_MODEL_DIR, HORIZON_DIR, TEXTURE_DIR, MINIMAP_DIR,
# SOUND_DIR, LIQUID_DIR, CLIENT_FILE_DIR (default data/client-files),
# WORLD_MAP_ZONE_MAP_DIR (default data/worldmap-zone-maps) and
# WMO_DOODAD_CACHE_DIR (default data/visual-wmo-doodads).

# Additional settings, all optional; the defaults are what you want on one machine.
# ASSET_WORKERS=0 publishes every generated asset with one process per cache miss instead of the
# long-lived asset workers (slower; for diagnosing a worker). A list keeps only those families on
# workers: texture (textures, icons, minimap index, zone maps, liquids, interface files), model,
# tile (ground splat, visual tile, horizon — one worker per kind), e.g. ASSET_WORKERS=texture,model.
# ASSET_WORKERS=1
# The gateway publishes, in the background, the models of the visual tile just served and of its eight
# neighbours (on by default, ASSET_PRELOAD=0 turns it off; needs the model and tile workers; the
# gateway that bat/32 serves to other players keeps it off). It runs only when
# every generation queue has been idle for 250 ms, one job at a time below normal priority, pausing
# after each job for as long as the job took times ASSET_PRELOAD_PACE (1), at most
# ASSET_PRELOAD_PER_MINUTE (120) jobs a minute and 600 per neighbourhood; it stops a minute after the
# last tile was served.
# ASSET_PRELOAD=0
# ASSET_PRELOAD_PER_MINUTE=120
# ASSET_PRELOAD_PACE=1
# HD textures (7.48): the effect textures tools/upscale-textures.mjs upscaled on the GPU are served from
# HD_TEXTURE_DIR (default .runtime/hd-textures) to a page whose enhanced setting «Чёткие текстуры эффектов» is on.
# HD_TEXTURES=0 switches them off. The gateway that bat/32 serves to other players keeps them off unless
# PUBLIC_HD_TEXTURES=1.
# HD_TEXTURES=1
# HD_TEXTURE_DIR=.runtime/hd-textures
# PUBLIC_HD_TEXTURES=0
# tools/upscale-textures.mjs finds Real-ESRGAN ncnn-vulkan in REALESRGAN_DIR (default .runtime/tools/realesrgan).
# REALESRGAN_DIR=.runtime/tools/realesrgan
# WEB_CROSS_ORIGIN_ISOLATION=0 stops sending COOP/COEP from the Vite page server; the crowd pose worker
# then stays off and poses are computed on the main thread.
# WEB_CROSS_ORIGIN_ISOLATION=1
# WEB_JS_PROFILING=0 stops sending `Document-Policy: js-profiling` (used by the freeze capture).
# WEB_JS_PROFILING=1
# WEBCLIENT_NODE_DIR: folder with node.exe for the .bat launchers and the Electron gateway; wins over
# .runtime\node and PATH.
# WEBCLIENT_NODE_DIR=C:/Program Files/nodejs
# TSWOW_PATCH_MANIFEST: the TSWoW patch publisher's manifest, when it is not beside the client.
# WEBCLIENT_URL: the page the Electron shell opens, as --webclient-url does (bench use).