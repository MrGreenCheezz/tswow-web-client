# Copy this file to .env and replace the paths with your own locations.
# Use forward slashes on Windows to keep the file easy to read.

# A legally obtained World of Warcraft 3.3.5a client (build 12340), containing Data/.
CLIENT_DIR=C:/Games/WoW-3.3.5a

# Optional exact AddOns.txt inside CLIENT_DIR/WTF. Without it, only byte-identical local profiles
# are used; divergent or missing profiles leave installed add-on defaults unchanged.
# CLIENT_ADDONS_FILE=C:/Games/WoW-3.3.5a/WTF/Account/MyAccount/MyRealm/MyCharacter/AddOns.txt

# Optional autonomous snapshot created by `npm run client-pack:build`. When set, every gateway and
# asset generator reads this pack instead of CLIENT_DIR. The source client can then be disconnected
# or moved; run `npm run client-pack:verify` after copying the pack to another disk.
# CLIENT_PACK_DIR=C:/tswow-web-client/dist/client-pack

# Optional explicit visual DBC overlay. Its DBC files are trusted as-is; keep it in sync with
# CLIENT_DIR yourself and copy the generated .src sidecars too when using patch-W/X/Y/Z-specific
# geoset policy. Without the override, data/visual-dbc is used only when every .src stamp matches
# the current client archive chain (`npm run assets:visual-dbc`).
# VISUAL_DBC_DIR=C:/Games/WoW-3.3.5a-visual-dbc

# Either point at a complete TSWoW installation...
TSWOW_INSTALL=C:/tswow/tswow-install
# ...or point directly at its built dataset. TSWOW_DATASET wins when both are set.
# TSWOW_DATASET=C:/tswow/tswow-install/modules/default/datasets/dataset

# Required before build/test for ignored local protocol tables, by `npm run client-data:generate`
# for matching client/core joins, and by full generated-source checks (`npm run build:full`).
TRINITYCORE_DIR=C:/tswow/tswow/cores/TrinityCore

# Must match the locale used by the client archives and realm data.
CLIENT_LOCALE=ruRU
VITE_CLIENT_LOCALE=ruRU

# After configuring these paths, generate the ignored local protocol/client tables for gameplay:
# npm run client-data:generate
# The generated files remain on this machine and must never be committed or redistributed.

# Safe single-machine defaults. For LAN use, change both hosts and restrict ALLOWED_ORIGINS.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8090
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_HOST=127.0.0.1
AUTH_PORT=3724
WORLD_HOST=127.0.0.1
WORLD_PORT=8085
WEB_HOST=127.0.0.1
WEB_PORT=5173
# Comma-separated DNS hostnames Vite may answer when WEB_HOST is exposed to a LAN.
# WEB_ALLOWED_HOSTS=wow.lan

# Optional public origin of the gateway or reverse proxy, without /auth or /world.
# When blank, the browser derives the gateway host from the current page and uses port 8090.
# Set this (including the port) whenever GATEWAY_PORT is not 8090.
# VITE_GATEWAY_ORIGIN=https://wow.example.com

# Optional overrides for a dataset with a custom layout.
# DBC_DIR=C:/tswow/dataset/dbc
# MAPS_DIR=C:/tswow/dataset/maps
# VMAPS_DIR=C:/tswow/dataset/vmaps
# MODULE_DIRS=C:/my-module-drafts;C:/tswow/tswow-install/modules>content
# WORLDSERVER_CONF=C:/tswow/realm/worldserver.conf
# MYSQL_BIN=C:/tswow/tswow-install/bin/mysql/mysql.exe

# Disabled by default. This allows local module UI writes and is accepted only from loopback.
MODULE_UI_WRITE=0

# A TSWoW `build addon` / `build data` rewrites the client patches; the running gateway then answers
# 409 client_patch_chain_changed (the page shows a banner) until it is restarted. Set this to 1 and
# `npm run gateway` stays as a small supervisor that restarts the already-built gateway by itself
# once the build has settled (no patch change for 5 s and TSWoW's last-client-build.json is newer,
# or 2 minutes without a marker) AND nobody is connected to /auth or /world. It never rebuilds and
# never starts the auth/world servers. `npm run patches:status` shows what the gateway serves.
# GATEWAY_RESTART_ON_PATCH=0

# Serving the game to other players from this machine (online/start-server.bat) and the app to send
# them (online/build-player.bat). PUBLIC_HOST is the address players reach this machine by; TCP
# PUBLIC_WEB_PORT (the page) and GATEWAY_PORT (8090, the gateway) must be forwarded to it. The
# server listens on PUBLIC_BIND (default 0.0.0.0, every interface) and never writes module UI.
# PUBLIC_HOST=203.0.113.10
# PUBLIC_WEB_PORT=8091
# PUBLIC_BIND=0.0.0.0

# Generated-cache locations may also be overridden when storage belongs elsewhere:
# CREATURE_METADATA_FILE, ITEM_METADATA_FILE, ITEM_ICON_DIR, SPELL_ICON_DIR,
# CREATURE_ICON_DIR, BUILDINGS_DIR, TERRAIN_TEXTURE_DIR, TERRAIN_LAYER_DIR,
# VISUAL_TILE_DIR, VISUAL_MODEL_DIR, HORIZON_DIR, TEXTURE_DIR, MINIMAP_DIR,
# SOUND_DIR and LIQUID_DIR.
