{
  "kind": "patch",
  "id": "target-extras",
  "format": 1,
  "target": "target-frame",
  "updated": "2026-08-24",
  "hide": ["target-frame/details"],
  "add": [
    {
      "slot": "target-frame/actions",
      "widget": {
        "id": "identify",
        "type": "Button",
        "name": "ExampleIdentifyButton",
        "width": 30,
        "height": 24,
        "anchor": { "point": "LEFT", "relativeTo": "parent", "relativePoint": "LEFT", "x": 0, "y": 0 },
        "text": { "ru": "?!", "en": "?!" },
        "tooltip": { "ru": "Отправить модулю облик цели", "en": "Send the target's display id" },
        "className": "example-identify",
        "enabled": "{target.exists}",
        "action": [
          {
            "do": "sendCustom",
            "message": "example.Request",
            "value": { "value": "{target.displayId}" }
          }
        ]
      }
    }
  ],
  "class": { "target-frame": "example-skin" },
  "css": ".example-skin { outline: 1px solid #d8b25a; }\n.example-identify { color: #d8b25a; }\n"
}
